                    "type": "a",
                    "claimed": true
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "emit": {
        "type": "b"
      },
      "expect": {
        "rejected": {
          "code": "SISO_CYCLE",
          "eventType": "b",
          "depth": 3,
          "at": [
            "b",
            "a",
            "b"
          ]
        }
      }
    },
    {
      "register": {
        "signature": "z",
        "does": {
          "nothing": true
        }
      },
      "refused": false
